# 새뜸365 매니저 환경변수 목록 (값은 넣지 않은 견본입니다)
# 실제 값은 .env 파일(커밋 금지)과 Vercel 프로젝트의 Environment Variables에만 넣습니다.

# 공용 비밀번호와 로그인 쿠키 서명 값 (AUTH_SECRET은 16자 이상, 길고 무작위로)
APP_PASSWORD=
AUTH_SECRET=

# AI (서버 쪽 코드에서만 읽음)
OPENAI_API_KEY=
OPENAI_MODEL=

# AI 사용 한도 (선택, 비워 두면 기본값: 1분 5번 · 하루 50번 · 한 달 1,000,000 토큰)
AI_LIMIT_PER_MINUTE=
AI_LIMIT_PER_DAY=
AI_MONTHLY_TOKEN_LIMIT=

# 배포 도구용 (선택, 앱 코드는 읽지 않음)
VERCEL_TOKEN=
